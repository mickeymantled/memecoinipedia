# Copy to .env and fill in. Never commit .env.

# Data providers (see docs/data-sources.md)
CODEX_API_KEY=
DUNE_API_KEY=
DEXPAPRIKA_API_KEY=
BIRDEYE_API_KEY=
HELIUS_API_KEY=

# Anthropic API (classification pipeline)
ANTHROPIC_API_KEY=
# Optional. The models for the first and second classification pass, and the taxonomy guide the
# prompt is built from. The defaults are in pipeline/src/classify/config.ts.
# CLASSIFY_FIRST_MODEL=
# CLASSIFY_SECOND_MODEL=
# CLASSIFY_TAXONOMY_PATH=

# Local Postgres. Tests create and drop their own temporary databases on this server.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/memecoinipedia
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/postgres

# Optional. Jupiter Tokens API answers without a key at 0.5 requests a second; a key raises it.
JUPITER_API_KEY=

# Optional. The port the API service listens on. Default 3001.
# PORT=3001

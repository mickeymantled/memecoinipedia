# Copy to .env and fill in. Never commit .env.

# Data providers (see docs/data-sources.md)
CODEX_API_KEY=
DUNE_API_KEY=
DEXPAPRIKA_API_KEY=
BIRDEYE_API_KEY=
HELIUS_API_KEY=

# Anthropic API (classification pipeline)
ANTHROPIC_API_KEY=

# Local Postgres. Tests create and drop their own temporary databases on this server.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/memecoinipedia
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/postgres
